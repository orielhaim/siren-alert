{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Siren Alert",
  "version": "0.1.0",
  "identifier": "com.orielhaim.siren-alert",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Siren Alert",
        "width": 720,
        "height": 740,
        "minWidth": 480,
        "minHeight": 600,
        "theme": "Dark",
        "backgroundColor": "#171717",
        "create": false
      },
      {
        "label": "alert",
        "title": "Siren Alert \u00b7 Alert",
        "url": "index.html?alert",
        "width": 420,
        "height": 340,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUyMTk2QzlFQTUzMDlDNDAKUldSQW5EQ2xubXdaVXF1M2I3UDh0VmdSR05XTm9JRW53ZTNXVGxSdXliaXhBTlUybWZZb1F0MDQK",
      "endpoints": [
        "https://github.com/orielhaim/siren-alert/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
